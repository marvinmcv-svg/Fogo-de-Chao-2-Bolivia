# Public site URL (canonical, sitemap, Open Graph). Defaults to https://fogodechao.bo
NEXT_PUBLIC_SITE_URL=https://fogodechao.bo

# Where contact-form and concierge leads are delivered (Slack/Discord incoming webhook, Zapier, Make, n8n…).
# Unset → the form falls back to a pre-filled WhatsApp message so no lead is silently lost.
LEAD_WEBHOOK_URL=

# Optional: lets the concierge answer free-text questions with Claude, grounded in verified facts only.
# Unset → the concierge uses its built-in rules and hands off to WhatsApp for anything else.
ANTHROPIC_API_KEY=
# CONCIERGE_MODEL=claude-haiku-4-5-20251001
